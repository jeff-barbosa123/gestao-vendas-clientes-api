BASE_URL=http://localhost:3000/api

# Admin demo credentials
ADMIN_EMAIL=admin@negocio.com
ADMIN_PASSWORD=admin123
ADMIN_PASSWORD_ALT=Admin@123!

# Additional demo user/block
OTHER_USER_EMAIL=user@negocio.com
OTHER_USER_PASSWORD=user123
BLOCKED_USER_EMAIL=bloqueado@teste.com
BLOCKED_USER_PASSWORD=123456

# JWT/session
JWT_SECRET=change-me
JWT_PREVIOUS_SECRET=
JWT_TTL_SECONDS=1800          # 30 minutes
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_PREVIOUS_SECRET=
JWT_REFRESH_TTL_SECONDS=604800 # 7 days

# Login security
LOGIN_MAX_FAILED_ATTEMPTS=3
LOGIN_BLOCK_MS=900000         # 15 minutes

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# Request size
JSON_LIMIT=1mb
