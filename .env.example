BASE_URL=http://localhost:3000/api

# Admin demo credentials
ADMIN_EMAIL=admin@negocio.com
ADMIN_PASSWORD=admin123
ADMIN_PASSWORD_ALT=Admin@123!

# Additional demo user/block
OTHER_USER_EMAIL=user@negocio.com
OTHER_USER_PASSWORD=user123
BLOCKED_USER_EMAIL=bloqueado@teste.com
BLOCKED_USER_PASSWORD=123456

# JWT/session
JWT_SECRET=change-me
JWT_PREVIOUS_SECRET=
JWT_TTL_SECONDS=1800          # 30 minutes
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_PREVIOUS_SECRET=
JWT_REFRESH_TTL_SECONDS=604800 # 7 days

# Login security
LOGIN_MAX_FAILED_ATTEMPTS=3
LOGIN_BLOCK_MS=900000         # 15 minutes

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# Request size
JSON_LIMIT=1mb

# Database
DATABASE_URL=postgres://sgvc:sgvc123@localhost:5432/sgvc

# Web URL (password reset link)
WEB_BASE_URL=http://localhost:4000

# Password reset
RESET_TOKEN_TTL_MINUTES=30
RESET_TOKEN_SECRET=change-me

# SMTP (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=seuemail@gmail.com
SMTP_PASS=senha-de-app
SMTP_FROM=seuemail@gmail.com
SMTP_FROM_NAME=SGVC

# Conecta Gov (CEP)
CONECTA_CEP_BASE_URL=https://h-apigateway.conectagov.estaleiro.serpro.gov.br/api-cep/v1/consulta/cep
CONECTA_OAUTH_TOKEN_URL=
CONECTA_CLIENT_ID=
CONECTA_CLIENT_SECRET=
CONECTA_SCOPE=
CONECTA_CPF_USUARIO=
CONECTA_OAUTH_USE_BASIC=true
