# ============================================
# AMBIENTE LOCAL (DESENVOLVIMENTO)
# ============================================
# Copie este arquivo para .env.local e ajuste conforme necessÃ¡rio
# Comando: cp env.local.example .env.local

# Ambiente
NODE_ENV=development

# Porta da API
PORT=3000

# URL do Frontend
WEB_BASE_URL=http://localhost:4000

# ============================================
# SEGURANÃ‡A - JWT Secrets (LOCAL)
# ============================================
# Para desenvolvimento local, pode usar valores menos seguros
# âš ï¸ NUNCA use estes valores em produÃ§Ã£o!
JWT_SECRET=dev-jwt-secret-local-development-only-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-local-development-only-change-in-production

# CORS - Local permite localhost
ALLOWED_ORIGINS=http://localhost:4000,http://127.0.0.1:4000,http://localhost:3001

# ============================================
# BANCO DE DADOS (LOCAL)
# ============================================
# PostgreSQL local via Docker
DATABASE_URL=postgresql://sgvc:sgvc123@localhost:5432/sgvc_local

# Ou use banco em memÃ³ria (remova DATABASE_URL)
# Se DATABASE_URL nÃ£o for definido, usa banco em memÃ³ria

# ============================================
# CONFIGURAÃ‡ÃƒO JWT
# ============================================
JWT_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=86400

# ============================================
# CONFIGURAÃ‡ÃƒO DE SENHAS
# ============================================
BCRYPT_SALT_ROUNDS=10
LOGIN_MIN_PASSWORD_LENGTH=8
LOGIN_MAX_PASSWORD_LENGTH=128
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_BLOCK_MINUTES=5

# ============================================
# USUÃRIOS PADRÃƒO (LOCAL)
# ============================================
ADMIN_EMAIL=admin@sgvc.local
ADMIN_PASSWORD=Admin@123!
OTHER_USER_EMAIL=user@sgvc.local
OTHER_USER_PASSWORD=User@123!

# ============================================
# RECUPERAÃ‡ÃƒO DE SENHA
# ============================================
RESET_TOKEN_TTL_MINUTES=60
RESET_TOKEN_SECRET=

# ============================================
# EMAIL (OPCIONAL - LOCAL)
# ============================================
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your-mailtrap-user
SMTP_PASS=your-mailtrap-password
SMTP_FROM=noreply@sgvc.local

# ============================================
# LOGGING
# ============================================
CONSOLE_LOG_LEVEL=debug
LOG_FILE=./logs/application.log
ERROR_LOG_FILE=./logs/error.log
AUDIT_LOG_FILE=./logs/audit.log

# ============================================
# LIMITES DE REQUISIÃ‡ÃƒO
# ============================================
JSON_LIMIT=10mb

# ============================================
# DESENVOLVIMENTO
# ============================================
DISABLE_RATE_LIMIT=false
ENABLE_SWAGGER_UI=true
