# ============================================
# AMBIENTE HMG (HOMOLOGAÇÃO / STAGING)
# ============================================
# Copie este arquivo para .env.hmg e ajuste conforme necessário
# Comando: cp env.hmg.example .env.hmg

# Ambiente
NODE_ENV=staging

# Porta da API
PORT=3000

# URL do Frontend (HMG)
WEB_BASE_URL=https://hmg.sgvc.com.br

# ============================================
# SEGURANÇA - JWT Secrets (HMG)
# ============================================
# ⚠️ Use secrets diferentes de produção!
# Gerar: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_HMG_JWT_SECRET_MINIMUM_32_CHARACTERS_LONG
JWT_REFRESH_SECRET=CHANGE_THIS_HMG_REFRESH_SECRET_MINIMUM_32_CHARACTERS_LONG

# CORS - HMG
ALLOWED_ORIGINS=https://hmg.sgvc.com.br,https://www.hmg.sgvc.com.br

# ============================================
# BANCO DE DADOS (HMG)
# ============================================
DATABASE_URL=postgresql://sgvc_hmg:CHANGE_PASSWORD@hmg-db.sgvc.com.br:5432/sgvc_hmg

# ============================================
# CONFIGURAÇÃO JWT
# ============================================
JWT_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=86400

# ============================================
# CONFIGURAÇÃO DE SENHAS
# ============================================
BCRYPT_SALT_ROUNDS=12
LOGIN_MIN_PASSWORD_LENGTH=8
LOGIN_MAX_PASSWORD_LENGTH=128
LOGIN_MAX_FAILED_ATTEMPTS=3
LOGIN_BLOCK_MINUTES=15

# ============================================
# USUÁRIOS PADRÃO (HMG)
# ============================================
ADMIN_EMAIL=admin@sgvc.com.br
ADMIN_PASSWORD=Admin@HMG123!ChangeMe
OTHER_USER_EMAIL=user@sgvc.com.br
OTHER_USER_PASSWORD=User@HMG123!ChangeMe

# ============================================
# RECUPERAÇÃO DE SENHA
# ============================================
RESET_TOKEN_TTL_MINUTES=30
RESET_TOKEN_SECRET=

# ============================================
# EMAIL (HMG)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hmg@sgvc.com.br
SMTP_PASS=CHANGE_APP_PASSWORD
SMTP_FROM=noreply@sgvc.com.br

# ============================================
# LOGGING
# ============================================
CONSOLE_LOG_LEVEL=info
LOG_FILE=./logs/application.log
ERROR_LOG_FILE=./logs/error.log
AUDIT_LOG_FILE=./logs/audit.log

# ============================================
# LIMITES DE REQUISIÇÃO
# ============================================
JSON_LIMIT=1mb

# ============================================
# HOMOLOGAÇÃO
# ============================================
DISABLE_RATE_LIMIT=false
ENABLE_SWAGGER_UI=true
