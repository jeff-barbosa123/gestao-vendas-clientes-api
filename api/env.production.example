# ============================================
# AMBIENTE PRODUÇÃO
# ============================================
# ⚠️ CRÍTICO: Copie este arquivo para .env.production e configure TODAS as variáveis
# Comando: cp env.production.example .env.production
# ⚠️ NUNCA commite o arquivo .env.production no repositório!

# Ambiente
NODE_ENV=production

# Porta da API
PORT=3000

# URL do Frontend (PRODUÇÃO)
WEB_BASE_URL=https://sgvc.com.br

# ============================================
# SEGURANÇA - JWT Secrets (PRODUÇÃO)
# ============================================
# ⚠️ OBRIGATÓRIO: Gerar secrets seguros e únicos
# Gerar: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_PRODUCTION_JWT_SECRET_MINIMUM_32_CHARACTERS_LONG_AND_RANDOM
JWT_REFRESH_SECRET=CHANGE_THIS_PRODUCTION_REFRESH_SECRET_MINIMUM_32_CHARACTERS_LONG_AND_RANDOM

# CORS - PRODUÇÃO
# ⚠️ OBRIGATÓRIO: Configure apenas os domínios permitidos
ALLOWED_ORIGINS=https://sgvc.com.br,https://www.sgvc.com.br

# ============================================
# BANCO DE DADOS (PRODUÇÃO)
# ============================================
# ⚠️ OBRIGATÓRIO: Configure o banco de dados de produção
DATABASE_URL=postgresql://sgvc_prod:CHANGE_STRONG_PASSWORD@prod-db.sgvc.com.br:5432/sgvc_production?ssl=true

# ============================================
# CONFIGURAÇÃO JWT
# ============================================
JWT_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=86400
JWT_PREVIOUS_SECRET=
JWT_REFRESH_PREVIOUS_SECRET=

# ============================================
# CONFIGURAÇÃO DE SENHAS
# ============================================
BCRYPT_SALT_ROUNDS=12
LOGIN_MIN_PASSWORD_LENGTH=8
LOGIN_MAX_PASSWORD_LENGTH=128
LOGIN_MAX_FAILED_ATTEMPTS=3
LOGIN_BLOCK_MINUTES=15

# ============================================
# USUÁRIOS PADRÃO (PRODUÇÃO)
# ============================================
# ⚠️ CRÍTICO: ALTERE estas senhas antes de usar em produção!
ADMIN_EMAIL=admin@sgvc.com.br
ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_MINIMUM_12_CHARACTERS
OTHER_USER_EMAIL=user@sgvc.com.br
OTHER_USER_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_MINIMUM_12_CHARACTERS

# ============================================
# RECUPERAÇÃO DE SENHA
# ============================================
RESET_TOKEN_TTL_MINUTES=30
RESET_TOKEN_SECRET=

# ============================================
# EMAIL (PRODUÇÃO)
# ============================================
# ⚠️ OBRIGATÓRIO: Configure o serviço de email para produção
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=production@sgvc.com.br
SMTP_PASS=CHANGE_APP_PASSWORD_OR_API_KEY
SMTP_FROM=noreply@sgvc.com.br

# ============================================
# LOGGING
# ============================================
CONSOLE_LOG_LEVEL=warn
LOG_FILE=./logs/application.log
ERROR_LOG_FILE=./logs/error.log
AUDIT_LOG_FILE=./logs/audit.log

# ============================================
# LIMITES DE REQUISIÇÃO
# ============================================
JSON_LIMIT=1mb

# ============================================
# PRODUÇÃO
# ============================================
# ⚠️ Configurações críticas de produção
DISABLE_RATE_LIMIT=false
ENABLE_SWAGGER_UI=false
