# Ambiente de TESTES automatizados (npm test)
# Copie para api/.env.test. Use um banco SEPARADO do de desenvolvimento:
# os testes criam e alteram dados.
NODE_ENV=test
DATABASE_URL=postgresql://sgvc:sgvc123@localhost:5432/sgvc_test

JWT_SECRET=test-jwt-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=test-refresh-secret-change-me-0123456789abcdef
ALLOWED_ORIGINS=http://localhost:4000

ADMIN_EMAIL=admin@sgvc.local
ADMIN_PASSWORD=Admin@123!
OTHER_USER_EMAIL=user@sgvc.local
OTHER_USER_PASSWORD=User@123!

LOGIN_MIN_PASSWORD_LENGTH=8
LOGIN_MAX_PASSWORD_LENGTH=128
ENABLE_SWAGGER_UI=true

# Limite global alto nos testes (a suíte faz centenas de requisições do mesmo IP);
# os limites específicos (login, exportação...) continuam valendo e são testados.
GLOBAL_RATE_LIMIT_MAX=5000
