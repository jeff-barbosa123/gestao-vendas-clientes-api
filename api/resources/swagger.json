          "rendimento": { "type": "number" },
          "yieldType": { "type": "string" },
          "ingredients": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/RecipeIngredient" }
          },
          "ingredientes": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/RecipeIngredientBR" }
          },
          "overhead": { "type": "number" },
          "labor": { "type": "number" },
          "costIngredients": { "type": "number" },
          "totalCost": { "type": "number" },
          "custoTotal": { "type": "number" },
          "priceMinimum": { "type": "number" },
          "priceSuggested": { "type": "number" },
          "costPerUnit": { "type": "number" },
          "custoUnitarioFinal": { "type": "number" },
          "marginLabel": { "type": "string" },
          "estimatedProfit": { "type": "number" }
        }
      },

      "SaleItem": {
        "type": "object",
