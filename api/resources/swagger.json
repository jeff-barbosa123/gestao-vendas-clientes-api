          "name": { "type": "string" },
          "description": { "type": "string" },
          "descricao": { "type": "string" },
          "price": { "type": "number" },
          "purchase_price": { "type": "number" },
          "statusProduto": { "type": "string", "enum": ["ATIVO", "INATIVO"] },
