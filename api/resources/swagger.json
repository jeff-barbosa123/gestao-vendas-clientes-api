            "type": "array",
            "items": { "$ref": "#/components/schemas/RecipeOverheadItem" }
          },
          "gastosIndiretos": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/RecipeOverheadItemBR" }
          },
