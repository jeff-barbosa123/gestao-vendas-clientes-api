          "updatedAt": { "type": "string", "format": "date-time", "nullable": true }
        },
        "required": ["id", "name", "yield", "ingredients", "costPerUnit", "totalCost"]
      },
      "RecipeCalculateRequest": { "$ref": "#/components/schemas/RecipeCreateRequest" },
      "RecipeCalculationResponse": {
        "type": "object",
