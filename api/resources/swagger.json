          "quantidadeVendas": { "type": "integer" }
        },
        "required": ["period", "total"]
      },

      "FinancialSummary": {
        "type": "object",
        "properties": {
          "revenue": { "type": "number" },
          "cmv": { "type": "number" },
          "profit": { "type": "number" },
          "margin": { "type": "number" },
          "avgTicket": { "type": "number" },
          "salesCount": { "type": "integer" }
        }
      },

      "FinancialRow": {
        "type": "object",
        "properties": {
          "period": { "type": "string" },
          "revenue": { "type": "number" },
          "cmv": { "type": "number" },
          "profit": { "type": "number" },
          "margin": { "type": "number" },
          "avgTicket": { "type": "number" },
          "salesCount": { "type": "integer" }
        }
      },

      "PriceSimulationByIdRequest": {
        "type": "object",
        "required": ["receitaId", "margem"],
        "properties": {
          "receitaId": { "type": "string" },
          "margem": { "type": "number" },
          "taxaEntrega": { "type": "number" }
        }
      },
      "PriceSimulationQuickRequest": {
        "type": "object",
        "required": ["ingredientes", "rendimento", "margem"],
        "properties": {
          "nome": { "type": "string" },
          "rendimento": { "type": "number" },
          "ingredientes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "nome": { "type": "string" },
                "quantidade": { "type": "number" },
                "custo": { "type": "number" }
              }
            }
          },
          "overhead": { "type": "number" },
          "overheads": { "type": "object", "additionalProperties": { "type": "number" } },
          "maoDeObra": { "type": "number" },
          "margem": { "type": "number" },
          "taxaEntrega": { "type": "number" }
        }
      },
      "PriceSimulationResponse": {
        "type": "object",
        "properties": {
          "custo_total": { "type": "number" },
          "custo_por_unidade": { "type": "number" },
          "preco_minimo": { "type": "number" },
          "preco_ideal": { "type": "number" },
          "margem": { "type": "number" },
          "taxa_entrega": { "type": "number" },
          "preco_final_simulado": { "type": "number" },
          "valor_lucro": { "type": "number" },
          "lucro_estimado": { "type": "number" },
          "custoUnitario": { "type": "number" },
          "margemLucroPercentual": { "type": "number" },
          "taxaEntrega": { "type": "number" },
          "precoFinalSimulado": { "type": "number" },
          "valorLucro": { "type": "number" },
          "lucroEstimado": { "type": "number" }
