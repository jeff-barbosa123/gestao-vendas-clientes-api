{
  "name": "gestao-vendas-clientes-workspace",
  "private": true,
  "workspaces": [
    "api"
  ],
  "scripts": {
    "start": "npm --workspace api start",
    "start:local": "npm --workspace api run start:local",
    "start:hmg": "npm --workspace api run start:hmg",
    "start:prod": "npm --workspace api run start:prod",
    "dev": "npm --workspace api run dev",
    "dev:local": "npm --workspace api run dev:local",
    "dev:hmg": "npm --workspace api run dev:hmg",
    "test": "npm --workspace api test",
    "test:local": "npm --workspace api run test:local",
    "test:hmg": "npm --workspace api run test:hmg",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:open:local": "CYPRESS_BASE_URL=http://localhost:4000 cypress open",
    "cypress:open:hmg": "CYPRESS_BASE_URL=https://hmg.sgvc.com.br cypress open",
    "cypress:open:prod": "CYPRESS_BASE_URL=https://sgvc.com.br cypress open",
    "cypress:run:local": "CYPRESS_BASE_URL=http://localhost:4000 cypress run",
    "cypress:run:hmg": "CYPRESS_BASE_URL=https://hmg.sgvc.com.br cypress run",
    "cypress:run:prod": "CYPRESS_BASE_URL=https://sgvc.com.br cypress run",
    "cypress:run:fluxo-completo": "cypress run --spec 'cypress/e2e/fluxo-completo.cy.js'",
    "cypress:run:fluxo-completo:novo-usuario": "CREATE_NEW_USER=true cypress run --spec 'cypress/e2e/fluxo-completo.cy.js'",
    "cypress:run:fluxo-completo:sem-receita": "CREATE_RECIPE=false cypress run --spec 'cypress/e2e/fluxo-completo.cy.js'",
    "cypress:open:fluxo-completo": "cypress open --config specPattern='cypress/e2e/fluxo-completo.cy.js'",
    "cypress:validate": "node scripts/validate-cypress-tests.js",
    "us001": "npm --workspace api run test:us001",
    "us002": "npm --workspace api run test:us002",
    "us003": "npm --workspace api run test:us003",
    "us004": "npm --workspace api run test:us004",
    "us005": "npm --workspace api run test:us005",
    "us006": "npm --workspace api run test:us006",
    "us007": "npm --workspace api run test:us007"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "axe-core": "^4.11.0",
    "cypress": "^15.8.1",
    "cypress-axe": "^1.7.0",
    "cypress-mochawesome-reporter": "^4.0.2",
    "cypress-real-events": "^1.15.0",
    "mochawesome": "^7.1.4"
  }
}
